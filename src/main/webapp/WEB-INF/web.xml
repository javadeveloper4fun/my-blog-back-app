<!--
    Конфигурация сервлет-контейнера Tomcat.
    Спринт 3: Тема 3 «Инфраструктурные бины Spring» (поднятие контекстов)
    и Тема 8 «Практика по разработке Spring Framework» (Tomcat, war).
    Реализация п. 12 (инфраструктура для создания war-файла).
    П. 13 (интеграция Spring-приложения с сервлет-контейнером):
    единый контекст Spring поднимается через DispatcherServlet (WebConfig),
    чей @ComponentScan инициализирует DataConfig, DAO, сервисы и контроллеры
    ровно по одному разу (без дублирования бинов из корневого контекста).
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>My Blog Backend</display-name>

    <servlet>
        <servlet-name>dispatcher</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>contextClass</param-name>
            <param-value>org.springframework.web.context.support.AnnotationConfigWebApplicationContext</param-value>
        </init-param>
        <init-param>
            <param-name>contextConfigLocation</param-name>
            <!-- WebConfig содержит @ComponentScan, который подхватит DataConfig, DAO, сервисы и контроллеры -->
            <param-value>ru.yandex.practicum.config.WebConfig</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>10485760</max-request-size>
        </multipart-config>
    </servlet>

    <servlet-mapping>
        <servlet-name>dispatcher</servlet-name>
        <!-- "/" принимает все запросы, но не перехватывает внутренние ресурсы контейнера (в отличие от "/*") -->
        <url-pattern>/</url-pattern>
    </servlet-mapping>

</web-app>
